# Shell scripts must be LF everywhere. A CRLF checkout breaks the installer for
# every user: bash reports "$'\r': command not found" before running anything.
*.sh            text eol=lf
# PowerShell on Windows expects CRLF; PowerShell 7 accepts either, but keeping
# CRLF means a Windows user can run the file without warnings.
*.ps1           text eol=crlf
*.md            text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
VERSION         text eol=lf
LICENSE         text eol=lf
.gitattributes  text eol=lf